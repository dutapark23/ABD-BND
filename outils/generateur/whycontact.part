<!-- WHY -->
    <section class="section" id="pourquoi" aria-labelledby="why-title">
      <div class="container">
        <header class="section-head">
          <p class="eyebrow" data-i18n="whyEyebrow">Notre méthode</p>
          <h2 id="why-title" data-i18n="whyTitle">Pourquoi Marina Immo</h2>
        </header>
        <ul class="why-grid">
          <li class="why-item">
            <span class="why-num" aria-hidden="true">01</span>
            <h3 data-i18n="why1Title">Expertise locale</h3>
            <p data-i18n="why1Text">Nous connaissons chaque quartier, chaque promoteur et les pièges à éviter sur place.</p>
          </li>
          <li class="why-item">
            <span class="why-num" aria-hidden="true">02</span>
            <h3 data-i18n="why2Title">Analyse chiffrée</h3>
            <p data-i18n="why2Text">Prix comparés aux transactions réelles, notamment les données du Dubai Land Department. Pas d'estimation au doigt mouillé.</p>
          </li>
          <li class="why-item">
            <span class="why-num" aria-hidden="true">03</span>
            <h3 data-i18n="why3Title">De la recherche aux clés</h3>
            <p data-i18n="why3Text">Sélection, visite, négociation, démarches, remise des clés : un seul interlocuteur du début à la fin.</p>
          </li>
          <li class="why-item">
            <span class="why-num" aria-hidden="true">04</span>
            <h3 data-i18n="why4Title">Français &amp; anglais</h3>
            <p data-i18n="why4Text">Tout est expliqué dans votre langue. Les documents, les chiffres, les étapes.</p>
          </li>
        </ul>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="section section-soft" id="contact" aria-labelledby="contact-title">
      <div class="container contact-grid">
        <div class="contact-intro">
          <p class="eyebrow" data-i18n="contactEyebrow">Contact</p>
          <h2 id="contact-title" data-i18n="contactTitle">Parlons de votre projet</h2>
          <p data-i18n="contactLead">Dites-nous ce que vous cherchez. Réponse sous 24 h ouvrées, avec une première sélection adaptée à votre budget.</p>
          <div class="contact-direct">
            <a class="btn btn-wa" data-wa-link href="#" target="_blank" rel="noopener">
              <svg class="wa-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.4-.3Z"/></svg>
              <span data-i18n="waCta">Écrire sur WhatsApp</span>
            </a>
            <p class="contact-email"><span data-i18n="orEmail">Ou par e-mail :</span> <a data-email-link href="#"></a></p>
          </div>
        </div>

        <form class="lead-form" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/merci.html">
          <input type="hidden" name="form-name" value="contact">
          <p class="hp" aria-hidden="true">
            <label>Ne pas remplir <input name="bot-field" tabindex="-1" autocomplete="off"></label>
          </p>
          <div class="form-row">
            <div class="field">
              <label for="c-name"><span data-i18n="lName">Nom complet</span> <span class="req" aria-hidden="true">*</span></label>
              <input id="c-name" name="name" type="text" autocomplete="name" required data-i18n-ph="phName" placeholder="Prénom Nom">
            </div>
            <div class="field">
              <label for="c-email"><span data-i18n="lEmail">E-mail</span> <span class="req" aria-hidden="true">*</span></label>
              <input id="c-email" name="email" type="email" autocomplete="email" required data-i18n-ph="phEmail" placeholder="vous@exemple.com">
            </div>
          </div>
          <div class="form-row">
            <div class="field">
              <label for="c-phone" data-i18n="lPhone">WhatsApp / téléphone</label>
              <input id="c-phone" name="phone" type="tel" autocomplete="tel" data-i18n-ph="phPhone" placeholder="+33 6 12 34 56 78">
            </div>
            <div class="field">
              <label for="c-country" data-i18n="lCountry">Pays d'intérêt</label>
              <select id="c-country" name="country">
                <option value="dubai" data-i18n="country_dubai">Dubaï</option>
                <option value="bali" data-i18n="country_bali">Bali</option>
                <option value="georgia" data-i18n="country_georgia">Géorgie</option>
                <option value="saudi" data-i18n="country_saudi">Arabie saoudite</option>
                <option value="undecided" data-i18n="undecided" selected>Je ne sais pas encore</option>
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="field">
              <label for="c-budget" data-i18n="lBudget">Budget (USD)</label>
              <select id="c-budget" name="budget">
                <option value="" data-i18n="optChoose">Choisir…</option>
                <option value="under-250k" data-i18n="budget1">Moins de 250 000 $</option>
                <option value="250k-500k" data-i18n="budget2">250 000 – 500 000 $</option>
                <option value="500k-1m" data-i18n="budget3">500 000 – 1 000 000 $</option>
                <option value="1m-2m" data-i18n="budget4">1 – 2 millions $</option>
                <option value="over-2m" data-i18n="budget5">Plus de 2 millions $</option>
              </select>
            </div>
            <div class="field">
              <label for="c-ref" data-i18n="lRef">Référence du bien</label>
              <input id="c-ref" name="listing_ref" type="text" data-i18n-ph="phRef" placeholder="ex. DXB-001">
            </div>
          </div>
          <div class="field">
            <label for="c-msg" data-i18n="lMessage">Message</label>
            <textarea id="c-msg" name="message" rows="4" data-i18n-ph="phMessage" placeholder="Votre projet, vos délais, vos questions…"></textarea>
          </div>
          <div class="field field-check">
            <input id="c-consent" name="consent" type="checkbox" value="yes" required>
            <label for="c-consent"><span data-i18n-html="lConsent">J'accepte que Marina Immo utilise ces informations pour me recontacter au sujet de mon projet. Elles ne sont ni vendues ni partagées. Voir la <a href="confidentialite.html">politique de confidentialité</a> et les <a href="mentions-legales.html">mentions légales</a>.</span> <span class="req" aria-hidden="true">*</span></label>
          </div>
          <button type="submit" class="btn btn-primary btn-block" data-i18n="submit">Envoyer ma demande</button>
          <p class="form-note" data-i18n="requiredNote">* Champs obligatoires</p>
        </form>
      </div>
    </section>
  